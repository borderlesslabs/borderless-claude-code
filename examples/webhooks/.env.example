# Borderless webhook handler — never commit real values

# Port the Express server listens on
PORT=3000

# PEM-formatted RSA public key for this organization. Fetch once from:
#   GET /v1/notifications/webhooks/settings/public-key
# Preserve newlines. Either paste the full PEM (use quotes + \n escapes, or
# a multi-line value if your loader supports it) or point to a file via
# BORDERLESS_WEBHOOK_PUBLIC_KEY_PATH instead.
BORDERLESS_WEBHOOK_PUBLIC_KEY=
