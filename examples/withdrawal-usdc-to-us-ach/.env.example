# Borderless sandbox — never commit real values
BORDERLESS_CLIENT_ID=
BORDERLESS_CLIENT_SECRET=

# An identity that has passed compliance for US/USD/ACH/USDC_POLYGON/Withdrawal
BORDERLESS_IDENTITY_ID=

# An account linked to that identity, holding USDC on Polygon
BORDERLESS_ACCOUNT_ID=

# The onchain address the account will send from. Must match the account's
# declared sender. Sending from a different address results in lost funds.
BORDERLESS_FROM_ADDRESS=

# Optional — set after first run to reuse the same payment instruction for
# repeat payouts. If unset, the example creates one and prints its id.
BORDERLESS_PAYMENT_INSTRUCTION_ID=

# Amount to withdraw, as a decimal string (USDC)
WITHDRAWAL_AMOUNT=10
