# Borderless sandbox — never commit real values
BORDERLESS_CLIENT_ID=
BORDERLESS_CLIENT_SECRET=

# Optional — if set, re-uses an existing identity instead of creating a new
# one. Useful when resuming after a ToS wait or a compliance check timeout.
BORDERLESS_IDENTITY_ID=

# Optional — override the placeholder first/last name so the identity is
# findable in the sandbox dashboard under your real name.
FIRST_NAME=
LAST_NAME=
