# Borderless sandbox — never commit real values
BORDERLESS_CLIENT_ID=
BORDERLESS_CLIENT_SECRET=

# An identity that has completed compliance for the corridor below.
# Output of ../compliance-personal/.
BORDERLESS_IDENTITY_ID=

# An on-chain address you control on the target chain. For USDC_POLYGON this
# is any EVM address. This address becomes the fromAddress for withdrawals
# and the destination for deposits. Never paste a private key here.
BORDERLESS_STANDALONE_ADDRESS=

# Asset + chain. Must match the asset in the compliance-check corridor.
ASSET=USDC_POLYGON

# Human-readable account name (3-50 chars).
ACCOUNT_NAME=Sandbox account
